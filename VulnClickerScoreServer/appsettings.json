{
  "Server": {
    "Urls": "https://localhost:8443;http://localhost:8080"
  },

  "Security": {
    "EnableHttpsRedirection": false,
    "EnableScoreValidation": true,
    "EnableRateLimit": true,
    "EnableVersionValidation": true,
    "AllowedHosts": "*"
  },

  "ScoreSettings": {
    "MaxPlayerNameLength": 32,
    "MaxVersionLength": 16
  },

  "Ranking": {
    "UseDefaultRanking": true,
    "MaxEntries": 10
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}